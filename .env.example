# ===== 云端 LLM（OpenAI 兼容协议：DeepSeek / 阿里云百炼 Qwen）=====
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_MODEL=deepseek-chat

# ===== 本地兜底（云端失败时自动降级）=====
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== MySQL（案件业务库）=====
MySQL_HOST=127.0.0.1
MySQL_PORT=3306
MySQL_USER=root
MySQL_PASSWORD=
MySQL_DATABASE=mingjing
MySQL_CHARSET=utf8mb4

# ===== Redis（会话记忆热缓存）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== JWT 鉴权 =====
JWT_SECRET=dev-only-secret-change-me-please-32bytes-min
JWT_ACCESS_EXPIRE_HOURS=24

# ===== 阿里云 OSS（对象存储：法条原文备份、附件、导出文书）=====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=mingjing-01
