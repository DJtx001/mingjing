# ===== 云端部署 .env 模板 =====
# 用法：云端项目根 `cp deploy/.env.docker.example .env` 后逐项填写。
# 说明：MySQL_HOST/REDIS_HOST 保持 127.0.0.1 即可——compose 在容器内强制覆盖为
#      服务名（mysql/redis），本地与云端 .env 可直接通用（只需换密钥与密码强度）。

# ===== 云端 LLM（照抄本地）=====
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_MODEL=deepseek-v4-flash

# ===== 本地兜底（已关闭，占位保留）=====
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== MySQL（host 保持 127.0.0.1，容器内由 compose 覆盖为服务名）=====
MySQL_HOST=127.0.0.1
MySQL_PORT=3306
MySQL_USER=root
MySQL_PASSWORD=换一个强密码（同时被 compose 读取为 MYSQL_ROOT_PASSWORD）
MySQL_DATABASE=mingjing
MySQL_CHARSET=utf8mb4

# ===== JWT 鉴权（★ 云端务必重新生成：python -c "import secrets;print(secrets.token_hex(32))"）=====
JWT_SECRET=
JWT_ACCESS_EXPIRE_HOURS=24

# ===== Redis（host 保持 127.0.0.1，容器内由 compose 覆盖为服务名）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 阿里云 OSS（照抄本地）=====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=mingjing-01

# ===== 向量模型（照抄本地）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
CHROMA_PATH=Chromadb
